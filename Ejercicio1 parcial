# Función recursiva para buscar Capitan America

def buscar_capitan(lista, indice):

    if indice >= len(lista):
        return False

    if lista[indice] == "Capitan America":
        return True

    return buscar_capitan(lista, indice + 1)


# Función recursiva para listar los superhéroes

def listar(lista, indice):

    if indice >= len(lista):
        return

    print(lista[indice])

    listar(lista, indice + 1)


# Programa principal

print("¿Está Capitan America?")

if buscar_capitan(superheroes, 0):
    print("Sí, está en la lista.")
else:
    print("No está.")

print("\nLista de superhéroes:")

listar(superheroes, 0)