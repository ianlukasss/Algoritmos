from super_heroes_data import superheroes

for hero in superheroes:
    print(hero['name'])

# 1. Ordenar por nombre

print("1) Personajes ordenados por nombre\n")

ordenados = sorted(superheroes, key=lambda x: x["name"])

for personaje in ordenados:
    print(personaje["name"])



# 2. Posición de The Thing y Rocket Raccoon


print("\n2) Posiciones\n")

for i, personaje in enumerate(superheroes):

    if personaje["name"] == "The Thing":
        print("The Thing está en la posición", i)

    if personaje["name"] == "Rocket Raccoon":
        print("Rocket Raccoon está en la posición", i)



# 3. Listar villanos

print("\n3) Villanos\n")

for personaje in superheroes:

    if personaje["is_villain"]:
        print(personaje["name"])



# 4. Cola de villanos

print("\n4) Villanos anteriores a 1980\n")

cola = []

# Agregar a los villanos
for hero in superheroes:
    if hero["is_villain"]:
        cola.append(hero)

# Sacar de la cola y mostrar los anteriores a 1980
while len(cola) > 0:

    villano = cola.pop(0)

    if villano["first_appearance"] < 1980:
        print(villano["name"], "-", villano["first_appearance"])

# 5. Superhéroes Bl, G, My y W

print("\n5) Superhéroes que empiezan con Bl, G, My y W\n")

for personaje in superheroes:

    if personaje["is_villain"] == False:

        nombre = personaje["name"]

        if (nombre.startswith("Bl")
                or nombre.startswith("G")
                or nombre.startswith("My")
                or nombre.startswith("W")):

            print(nombre)


# 6. Ordenados por nombre real


print("\n6) Ordenados por nombre real\n")

ordenados = sorted(
    superheroes,
    key=lambda x: x["real_name"] if x["real_name"] else ""
)

for personaje in ordenados:

    print(personaje["real_name"], "-", personaje["name"])


# 7. Superhéroes ordenados por aparición

print("\n7) Superhéroes ordenados por aparición\n")

heroes = []

for personaje in superheroes:

    if personaje["is_villain"] == False:
        heroes.append(personaje)

heroes.sort(key=lambda x: x["first_appearance"])

for personaje in heroes:

    print(personaje["first_appearance"], "-", personaje["name"])



# 8. Cambiar nombre real de Ant Man

print("\n8) Modificar Ant Man\n")

for personaje in superheroes:

    if personaje["name"] == "Ant Man":

        personaje["real_name"] = "Scott Lang"

        print(personaje)



# 9. Buscar palabras en la biografía

print("\n9) Biografía contiene 'time-traveling' o 'suit'\n")

for personaje in superheroes:

    bio = personaje["short_bio"].lower()

    if "time-traveling" in bio or "suit" in bio:
        print(personaje["name"])



# 10. Eliminar Electro y Baron Zemo

print("\n10) Eliminar Electro y Baron Zemo\n")

for nombre in ["Electro", "Baron Zemo"]:

    for personaje in superheroes[:]:

        if personaje["name"] == nombre:

            print("Eliminando:")

            print(personaje)

            superheroes.remove(personaje)

print("\nCantidad final:", len(superheroes))